#!/usr/bin/env bash
# claude-tabs: all Claude Code sessions of one project, kept in one tmux session.
# Run from the project directory.
#
#   claude-tabs            show the project's Claude tabs in this terminal
#   claude-tabs --ensure   only make sure they exist (used by claude-hub), don't show them
#   claude-tabs --sync     rewrite the state file in the order of the tabs, dropping closed ones
#                          (after a tab is dragged, moved or opened)
#   claude-tabs --close <window>   close a tab for good: it does not come back after a reboot
#
# If the project's tmux session is gone (first start, reboot), the tabs are rebuilt from the
# state file, each one resuming its previous conversation. Never prompts.
#
# State: ~/.local/state/claude-tabs/<project-slug>, lines "<tab-key>\t<session-id>\t<name>",
# maintained by claude-tab (per-window wrapper) and claude-tab-hook (SessionStart hook).
# <project-slug>.path holds the project directory, so claude-hub can restore every project.
set -u
export PATH="$HOME/.local/bin:$PATH"

proj=$PWD
# In the home folder there is no project: show the hub instead of making a project named after the user.
[ "$proj" = "$HOME" ] && [ -z "${1:-}" ] && exec "$HOME/.local/bin/claude-hub"
slug=$(printf '%s' "$proj" | tr -c 'A-Za-z0-9\n' '-')   # tmux names may not contain . or :
sess="cc$slug"
state="$HOME/.local/state/claude-tabs/$slug"
conf="$HOME/.config/claude-tabs/tmux.conf"
mkdir -p "$(dirname "$state")"; touch "$state"
printf '%s\n' "$proj" > "$state.path"
tmux() { command tmux ${CLAUDE_TABS_SOCKET:+-L "$CLAUDE_TABS_SOCKET"} "$@"; }   # CLAUDE_TABS_SOCKET: for tests

# Each window carries its tab key in @tabkey (set by claude-tab). Lines are ordered by window
# index; a line whose window is gone was closed, so it goes. Only called while the session runs:
# a reboot kills the windows but must keep the lines.
sync() {
    local keys prog='BEGIN { n = split(keys, k, "\n"); for (i = 1; i <= n; i++) pos[k[i]] = i }
                     $1 in pos { print pos[$1] "\t" $0 }'
    keys=$(tmux list-windows -t "=$sess" -F '#{@tabkey}' 2>/dev/null)   # no session: last tab closed
    claude-tabs-lock "$state.lock" sh -c '
        awk -F"\t" -v keys="$1" "$2" "$3" | sort -s -n -k1,1 | cut -f2- > "$3.tmp" && mv "$3.tmp" "$3"
    ' _ "$keys" "$prog" "$state"
}

case ${1:-} in
    --ensure) show=0 ;;
    --sync) sync; exit ;;
    --close) tmux kill-window -t "${2:?usage: claude-tabs --close <window>}"; sync; exit ;;
    "") show=1 ;;
    *) echo "usage: claude-tabs [--ensure | --sync | --close <window>]" >&2; exit 2 ;;
esac

build() {
    # Transcripts live in ~/.claude/projects/<encoded cwd>/<session-id>.jsonl
    local tdir="" cand f id sid name c
    for cand in "$(printf '%s' "$proj" | sed 's#[/._]#-#g')" "$(printf '%s' "$proj" | sed 's#/#-#g')"; do
        [ -d "$HOME/.claude/projects/$cand" ] && { tdir="$HOME/.claude/projects/$cand"; break; }
    done
    has_transcript() { [ -n "$tdir" ] && [ -s "$tdir/$1.jsonl" ]; }

    # One command per recorded tab. A tab whose session never got a transcript (or whose id
    # we lost track of) gets the most recent conversation of this project that no other tab
    # holds, which beats an empty session.
    # bash 3.2 (macOS) has no associative arrays: "taken" is a space-separated id list.
    local cmds=() taken=" "
    while IFS=$'\t' read -r _ sid _; do has_transcript "$sid" && taken+="$sid "; done < "$state"
    while IFS=$'\t' read -r _ sid name; do
        [ -n "$sid$name" ] || continue
        if ! has_transcript "$sid"; then
            sid=""
            if [ -n "$tdir" ]; then
                for f in $(ls -t "$tdir"/*.jsonl 2>/dev/null); do
                    id=$(basename "$f" .jsonl)
                    case $taken in *" $id "*) continue ;; esac
                    [ -s "$f" ] && { sid=$id; taken+="$id "; break; }
                done
            fi
        fi
        if [ -n "$sid" ]; then cmds+=("$(printf '%q resume %q %q' "$HOME/.local/bin/claude-tab" "$sid" "$name")")
        else cmds+=("$(printf '%q new %q' "$HOME/.local/bin/claude-tab" "${name:-$(basename "$proj") 1}")"); fi
    done < "$state"
    [ ${#cmds[@]} -eq 0 ] && cmds+=("$(printf '%q new %q' "$HOME/.local/bin/claude-tab" "$(basename "$proj") 1")")

    : > "$state"     # the windows re-record themselves with fresh tab keys
    tmux -u -f "$conf" new-session -d -s "$sess" -c "$proj" "${cmds[0]}"
    for c in "${cmds[@]:1}"; do tmux new-window -d -t "=$sess" -c "$proj" "$c"; done
}

tmux has-session -t "=$sess" 2>/dev/null || build
[ "$show" = 1 ] || exit 0
tmux -u attach -t "=$sess"   # not exec: that would skip the tmux() wrapper
