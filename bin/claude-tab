#!/usr/bin/env bash
# claude-tab: runs one Claude Code session inside a claude-tabs window and keeps the
# project's state file in sync, so the tab comes back after a reboot.
#
#   claude-tab new [name]      start a fresh session (asks for a name unless given;
#                              answering r opens the past-chat picker instead)
#   claude-tab resume <id> [name]   resume a saved session
#   claude-tab fork <id> <name> [prompt]   branch a conversation: a new session that starts
#                              with everything said so far in <id> (used by the branch-tab skill)
#
# State file lines: "<tab-key>\t<session-id>\t<name>". The session id is kept current by the
# SessionStart hook (claude-tab-hook) when /resume or /clear switch the conversation inside
# the tab. A line stays until Claude exits *cleanly* (you quit it); a reboot or a crash leaves
# it, which is what lets claude-tabs restore the tab.
set -u
export PATH="$HOME/.local/bin:$PATH"
# Optional ~/.config/claude-tabs/claude-flags: one line of flags every tab starts Claude with,
# e.g. --dangerously-skip-permissions. No file, no extra flags.
flags="$HOME/.config/claude-tabs/claude-flags"
opts=(); [ -f "$flags" ] && read -ra opts < "$flags"
run_claude() { claude ${opts[@]+"${opts[@]}"} "$@"; }   # bash 3.2 (macOS) chokes on an empty "${opts[@]}"

slug=$(printf '%s' "$PWD" | tr -c 'A-Za-z0-9\n' '-')
export CLAUDE_TABS_STATE="$HOME/.local/state/claude-tabs/$slug"
export CLAUDE_TAB_KEY
uuid() { uuidgen | tr 'A-F' 'a-f'; }   # macOS uuidgen prints upper case
CLAUDE_TAB_KEY=$(uuid)
mkdir -p "$(dirname "$CLAUDE_TABS_STATE")"; touch "$CLAUDE_TABS_STATE"

lock()   { claude-tabs-lock "$CLAUDE_TABS_STATE.lock" "$@"; }
record() { lock sh -c 'printf "%s\t%s\t%s\n" "$1" "$2" "$3" >> "$4"' _ "$CLAUDE_TAB_KEY" "$1" "$2" "$CLAUDE_TABS_STATE"; }
forget() { lock sh -c 'awk -F"\t" -v k="$1" "\$1 != k" "$2" > "$2.tmp" && mv "$2.tmp" "$2"' _ "$CLAUDE_TAB_KEY" "$CLAUDE_TABS_STATE"; }

mode=${1:-new}
case $mode in
    new)
        name=${2:-}
        if [ -z "$name" ]; then
            # The name labels the tab, the /resume picker and the mobile app list.
            default="$(basename "$PWD") $(( $(grep -c . "$CLAUDE_TABS_STATE") + 1 ))"
            echo "New Claude session. Type a name, press Enter for \"$default\","
            read -r -e -p "or type r to reopen a past chat: " name
            name=${name:-$default}
        fi
        if [ "$name" = r ] || [ "$name" = /resume ]; then
            # Past chat keeps its own name everywhere (tab, /resume list, mobile app).
            # The SessionStart hook records which conversation was picked.
            record "picking" ""
            run_claude --resume; rc=$?
        else
            sid=$(uuid)
            record "$sid" "$name"
            run_claude --session-id "$sid" --name "$name"; rc=$?
        fi
        ;;
    resume)
        sid=${2:?session id required}
        record "$sid" "${3:-}"
        run_claude --resume "$sid"; rc=$?      # the session's own name is stored with it
        ;;
    fork)
        # The forked session gets a fresh id that only Claude knows; the SessionStart hook
        # replaces the placeholder with it, as after /resume.
        sid=${2:?session id required}; name=${3:?name required}
        record "forking" "$name"
        run_claude --resume "$sid" --fork-session --name "$name" ${4:+"$4"}; rc=$?
        ;;
    *) echo "usage: claude-tab new [name] | resume <id> [name] | fork <id> <name> [prompt]" >&2; exit 2 ;;
esac

forget
if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ]; then
    echo; echo "Claude exited with code $rc. Press Enter to close this tab."; read -r
fi
