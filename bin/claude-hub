#!/usr/bin/env bash
# claude-hub: one window with the Claude tabs of every project. The top row of the bar lists
# the projects, the bottom row the tabs of the selected one. Opened in kitty at login
# (~/.config/autostart/claude-hub.desktop); also in the app menu as "Claude hub".
#
#   claude-hub              restore every project's tabs (after a reboot) and show them
#   claude-hub add [dir]    give a project Claude tabs; it appears in the top row. Without a
#                           dir it asks for one (the "+" at the end of the projects row)
#   claude-hub remove <dir> close a project's tabs and drop it from the hub; its chats stay in
#                           Claude's /resume list (right-click a project in the top row)
#   claude-hub move <session> <-1|+1|session id>   move a project along the top row (Alt+Shift+Up/Down
#                           or dragging it); the order lives in ~/.local/state/claude-tabs/order
#   claude-hub bar          redraw the top row from that order (tmux hooks run it when a project appears or goes)
set -u
export PATH="$HOME/.local/bin:$PATH"
tmux() { command tmux ${CLAUDE_TABS_SOCKET:+-L "$CLAUDE_TABS_SOCKET"} "$@"; }
statedir=$HOME/.local/state/claude-tabs
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9\n' '-'; }   # as in claude-tabs
order=$statedir/order   # project dirs, one per line, in top-row order; projects not listed follow alphabetically
tab=$(printf '\t')
ordered() {   # the cc- sessions as "id<TAB>name<TAB>dir" in top-row order
    tmux list-sessions -F "#{session_id}$tab#{session_name}$tab#{session_path}" 2>/dev/null \
        | awk -F'\t' -v order="$(cat "$order" 2>/dev/null)" '
            BEGIN { n = split(order, o, "\n"); for (i = 1; i <= n; i++) pos[o[i]] = i }
            $2 ~ /^cc-/ { print ($3 in pos ? pos[$3] : n + 1) "\t" $0 }' \
        | sort -s -t "$tab" -k1,1n -k3,3 | cut -f2-
}

case ${1:-} in
    add)
        dir=${2:-}
        if [ -z "$dir" ]; then   # run in a popup from the projects row: ask, then show the project
            read -e -p "Project folder to add (Tab completes): " dir   # no -r: completion escapes spaces
            dir=$(cd "${dir/#\~/$HOME}" && pwd) && (cd "$dir" && claude-tabs --ensure) \
                && { tmux switch-client -t "=cc$(slug "$dir")"; exit; }   # not exec: skips tmux()
            read -r -p "Press Enter to close."; exit 1
        fi
        dir=$(cd "$dir" && pwd) || exit 1
        (cd "$dir" && claude-tabs --ensure) && echo "Added $(basename "$dir") to the Claude hub."
        exit ;;
    remove)
        dir=$(cd "${2:?usage: claude-hub remove <project dir>}" && pwd) || exit 1
        exec "$0" drop "cc$(slug "$dir")" ;;
    drop)        # drop <session>: what remove does, by tmux session name
        tmux kill-session -t "=$2" 2>/dev/null   # not running is fine: the state still goes
        dir=$(cat "$statedir/${2#cc}.path" 2>/dev/null) && [ -f "$order" ] \
            && { grep -vxF -- "$dir" "$order" > "$order.tmp"; mv "$order.tmp" "$order"; }
        rm -f "$statedir/${2#cc}" "$statedir/${2#cc}.path" "$statedir/${2#cc}.lock"
        exit ;;
    ask-remove)  # ask-remove <session id> <client>: right-click on a project in the top row
        name=$(basename "$(tmux display -p -t "$2" '#{session_path}')")
        tmux confirm-before -b -t "$3" -p "Remove $name from the hub? Its chats stay in /resume. (y/n)" \
            "run-shell '~/.local/bin/claude-hub drop $(tmux display -p -t "$2" '#{session_name}')'"
        exit ;;
    bar)
        fmt="#[align=left bg=colour234 fg=colour245 bold]  Projects  #[nobold]│ #[list=on align=left]#[list=left-marker]<#[list=right-marker]>#[list=on]"
        while IFS=$tab read -r id name dir; do   # the current project is matched by suffix: the desk joins it as "web<name>"
            fmt+="#[range=user|$id]#{?#{m:*$name,#{client_session}},#[list=focus bg=colour31 fg=white bold],#[bg=colour239 fg=colour255 bold]}  ${dir##*/}  #[norange list=on bg=colour234 fg=colour245 nobold] "
        done < <(ordered)
        tmux set -g 'status-format[0]' "$fmt#[nolist align=right bg=colour234 fg=colour245]#[range=user|addproject]  +  #[norange]#[fill=colour234]"
        exit ;;
    move)        # move <session name> <-1|+1|session id>: one step along the top row, or swap with the project under the mouse
        dirs=() me=0 to=0
        while IFS=$tab read -r id name dir; do
            dirs+=("$dir"); [ "$name" = "$2" ] && me=${#dirs[@]}; [ "$id" = "$3" ] && to=${#dirs[@]}
        done < <(ordered)
        case $3 in -1|+1) to=$((me $3)) ;; esac
        [ "$me" -gt 0 ] && [ "$to" -gt 0 ] && [ "$to" -le ${#dirs[@]} ] && [ "$to" != "$me" ] || exit 0
        tmp=${dirs[me-1]}; dirs[me-1]=${dirs[to-1]}; dirs[to-1]=$tmp
        printf '%s\n' "${dirs[@]}" > "$order"
        exec "$0" bar ;;
esac

for p in "$statedir"/*.path; do
    [ -f "$p" ] || continue
    dir=$(cat "$p")
    [ -d "$dir" ] && [ -s "${p%.path}" ] || continue    # skip projects with no open tabs
    (cd "$dir" && claude-tabs --ensure)
done

target=$(tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null | grep ' cc-' | sort -rn | head -1 | cut -d' ' -f2)
if [ -z "$target" ]; then
    echo "No project has Claude tabs yet. Add one with:  claude-hub add <project dir>"
    exec bash
fi
tmux -u attach -t "=$target"   # not exec: that would skip the tmux() wrapper
